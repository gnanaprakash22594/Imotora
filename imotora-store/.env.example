# Supabase PostgreSQL Session Pooler URI (Required)
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# CORS (Replace with your live Vercel & Render domains)
STORE_CORS=https://your-storefront.vercel.app,http://localhost:3000
ADMIN_CORS=https://your-backend.onrender.com,http://localhost:9000
AUTH_CORS=https://your-storefront.vercel.app,https://your-backend.onrender.com,http://localhost:3000,http://localhost:9000

# Public URLs
MEDUSA_BACKEND_URL=https://your-backend.onrender.com
STOREFRONT_URL=https://your-storefront.vercel.app

# Secrets (Generate long random strings in production)
JWT_SECRET=replace-with-strong-random-secret
COOKIE_SECRET=replace-with-strong-random-secret

# Optional: Managed Redis (Upstash / Render Redis)
# REDIS_URL=rediss://default:<token>@<host>:6379

# Optional: Live Google OAuth Sign-In
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CALLBACK_URL=https://your-storefront.vercel.app/in/account?google_callback=1
