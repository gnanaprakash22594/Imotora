# Live Medusa Backend URL on Render (no trailing slash)
MEDUSA_BACKEND_URL=https://your-backend.onrender.com

# Generated when you run `npm run seed` on your Medusa backend
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_key_from_medusa

# Your live Vercel storefront URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-storefront.vercel.app

# Default region (India INR)
NEXT_PUBLIC_DEFAULT_REGION=in

# Next.js on-demand revalidation secret
REVALIDATE_SECRET=replace-with-random-secret
